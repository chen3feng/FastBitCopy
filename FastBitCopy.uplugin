{
	"FileVersion": 3,
	"Version": 1,
	"VersionName": "1.0.0",
	"FriendlyName": "Fast Bit Copy",
	"Description": "Runtime hook of UE's appBitsCpy with an optimized implementation (up to ~30x faster on aligned copy, ~5x on unaligned). Supports Win/Linux/Mac on x64 and arm64.",
	"Category": "Performance",
	"CreatedBy": "chen3feng",
	"CreatedByURL": "https://github.com/chen3feng/FastBitCopy",
	"DocsURL": "",
	"MarketplaceURL": "",
	"SupportURL": "",
	"CanContainContent": false,
	"IsBetaVersion": false,
	"IsExperimentalVersion": false,
	"Installed": false,
	"Modules": [
		{
			"Name": "FastBitCopy",
			"Type": "Runtime",
			"LoadingPhase": "PostConfigInit",
			"PlatformAllowList": [ "Win64", "Linux", "Mac" ]
		},
		{
			"Name": "FastBitCopyTests",
			"Type": "DeveloperTool",
			"LoadingPhase": "Default",
			"PlatformAllowList": [ "Win64", "Linux", "Mac" ]
		}
	]
}
